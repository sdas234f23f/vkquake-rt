//
// Q2RTX-style per-cell light lists (the 16^3 camera-centered grid cells act as
// "clusters"). For every cell, collects the lights whose bounding sphere
// overlaps the cell sphere into a fixed-size list (Q2_LIGHT_LIST_MAX_PER_CELL).
// The directional light is handled separately by the sun (get_sunlight) and is
// NOT added to the lists, exactly like Q2RTX.
//
// The lists feed the Q2RTX light-selection CDF (Q2LightLists.h, ported from
// Q2RTX light_lists.h) and the adaptive shadow statistics (q2LightStats).

#version 460

#define DESC_SET_GLOBAL_UNIFORM 0
#define DESC_SET_RANDOM 1
#define DESC_SET_LIGHT_SOURCES 2
#include "ShaderCommonGLSLFunc.h"
#include "Random.h"
#include "BRDF.h"
#include "Light.h"

layout(local_size_x = COMPUTE_Q2_LIGHT_LIST_GROUP_SIZE_X, local_size_y = 1, local_size_z = 1) in;

// Cell math (same as LightGrid.h, inlined to avoid pulling in Reservoir.h).
vec3 q2llCellDelta()
{
    return vec3(globalUniform.cellWorldSize);
}

vec3 q2llCellWholeSize()
{
    return q2llCellDelta() * vec3(Q2_LIGHT_LIST_SIZE_X, Q2_LIGHT_LIST_SIZE_Y, Q2_LIGHT_LIST_SIZE_Z);
}

float q2llCellRadius()
{
    return length(q2llCellDelta()) * 0.5;
}

vec3 q2llCellCenter()
{
    // offset a bit, so camera is in the center of the cell
    return globalUniform.cameraPosition.xyz + q2llCellDelta() * 0.5;
}

vec3 q2llCellMinExtent()
{
    return q2llCellCenter() - q2llCellWholeSize() * 0.5;
}

vec3 q2llCellWorldCenter(ivec3 cellIndex)
{
    return q2llCellMinExtent() + q2llCellDelta() * (vec3(cellIndex) + 0.5);
}

// Approximate the bounding sphere of a light (for cell inclusion tests).
void q2llLightSphere(const ShLightEncoded l, out vec3 lightPos, out float lightRadius)
{
    if (l.lightType == LIGHT_TYPE_SPHERE || l.lightType == LIGHT_TYPE_SPOT)
    {
        lightPos = l.data_0.xyz;
        lightRadius = l.data_0.w;
    }
    else if (l.lightType == LIGHT_TYPE_TRIANGLE)
    {
        const vec3 p0 = l.data_0.xyz;
        const vec3 p1 = l.data_1.xyz;
        const vec3 p2 = l.data_2.xyz;
        lightPos = (p0 + p1 + p2) / 3.0;
        lightRadius = max(max(length(p0 - lightPos), length(p1 - lightPos)), length(p2 - lightPos));
    }
    else
    {
        lightPos = vec3(0.0);
        lightRadius = 0.0;
    }
}

void main()
{
    const int cellIndexLinear = int(gl_GlobalInvocationID.x);
    if (cellIndexLinear >= Q2_LIGHT_LIST_CELL_COUNT)
    {
        return;
    }

    const ivec3 cellIndex = ivec3(
        cellIndexLinear % Q2_LIGHT_LIST_SIZE_X,
        (cellIndexLinear / Q2_LIGHT_LIST_SIZE_X) % Q2_LIGHT_LIST_SIZE_Y,
        cellIndexLinear / (Q2_LIGHT_LIST_SIZE_X * Q2_LIGHT_LIST_SIZE_Y));

    const vec3 cellCenter = q2llCellWorldCenter(cellIndex);
    const float cellRadius = q2llCellRadius();

    const uint maxPerCell = uint(Q2_LIGHT_LIST_MAX_PER_CELL);
    const uint listBase = uint(cellIndexLinear) * maxPerCell;

    uint count = 0;
    const uint lightCount = globalUniform.lightCount;

    for (uint i = 0; i < lightCount && count < maxPerCell; i++)
    {
        const uint li = uint(LIGHT_ARRAY_REGULAR_LIGHTS_OFFSET) + i;
        const ShLightEncoded l = lightSources[li];

        vec3 lightPos;
        float lightRadius;
        q2llLightSphere(l, lightPos, lightRadius);

        if (lightRadius <= 0.0)
        {
            continue;
        }

        // Light affects this cell if its bounding sphere overlaps the cell sphere.
        if (length(lightPos - cellCenter) <= lightRadius + cellRadius)
        {
            q2CellLightList[listBase + count] = li;
            count++;
        }
    }

    q2CellLightCount[cellIndexLinear] = count;
}
