// Ported from Q2RTX (GPL v2) shader/asvgf_taau.comp. Adapted to RTGL1: the
// input is the already tonemapped Final, so the PQ transfer is not applied.

#version 460

// Temporal anti-aliasing + upscale (TAAU) for the new Q2RTX core path.
// Reads the tonemapped Final at render resolution and outputs UpscaledPing at
// the upscaled resolution, replacing the FSR/DLSS upscalers on the new path.

#define DESC_SET_FRAMEBUFFERS 0
#define DESC_SET_GLOBAL_UNIFORM 1
#include "ShaderCommonGLSLFunc.h"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

const float taa_motion_weight_mix = 0.1;
const float taa_variance = 1.0;

void
BicubicCatmullRom(vec2 UV, vec2 texSize, out vec2 Sample[3], out vec2 Weight[3])
{
    const vec2 invTexSize = 1.0 / texSize;

    vec2 tc = floor(UV - 0.5) + 0.5;
    vec2 f = UV - tc;
    vec2 f2 = f * f;
    vec2 f3 = f2 * f;

    vec2 w0 = f2 - 0.5 * (f3 + f);
    vec2 w1 = 1.5 * f3 - 2.5 * f2 + 1;
    vec2 w3 = 0.5 * (f3 - f2);
    vec2 w2 = 1 - w0 - w1 - w3;

    Weight[0] = w0;
    Weight[1] = w1 + w2;
    Weight[2] = w3;

    Sample[0] = tc - 1;
    Sample[1] = tc + w2 / Weight[1];
    Sample[2] = tc + 2;

    Sample[0] *= invTexSize;
    Sample[1] *= invTexSize;
    Sample[2] *= invTexSize;
}

/* uv is in pixel coordinates */
vec4
sample_texture_catmull_rom(sampler2D tex, vec2 uv)
{
    vec4 sum = vec4(0);
    vec2 sampleLoc[3], sampleWeight[3];
    BicubicCatmullRom(uv, vec2(textureSize(tex, 0)), sampleLoc, sampleWeight);
    for(int i = 0; i < 3; i++)
    {
        for(int j = 0; j < 3; j++)
        {
            vec2 uvv = vec2(sampleLoc[j].x, sampleLoc[i].y);
            vec4 c = textureLod(tex, uvv, 0);
            sum += c * vec4(sampleWeight[j].x * sampleWeight[i].y);
        }
    }
    return sum;
}

float get_sample_weight(vec2 delta, float scale)
{
    return clamp(1.0 - scale * dot(delta, delta), 0, 1);
}

void main()
{
    const ivec2 opos = ivec2(gl_GlobalInvocationID);

    const int renderWidth = int(globalUniform.renderWidth);
    const int renderHeight = int(globalUniform.renderHeight);
    const int outWidth = int(globalUniform.upscaledRenderWidth);
    const int outHeight = int(globalUniform.upscaledRenderHeight);

    if (opos.x >= outWidth || opos.y >= outHeight)
    {
        return;
    }

    // Map the output pixel to the render resolution
    const vec2 render_to_output = vec2(renderWidth, renderHeight) / vec2(outWidth, outHeight);
    const vec2 sub_pixel_jitter = vec2(globalUniform.jitterX, globalUniform.jitterY);
    const vec2 nearest_render_pos = (vec2(opos) + vec2(0.5)) * render_to_output - vec2(0.5) - sub_pixel_jitter;
    const ivec2 int_render_pos = ivec2(clamp(round(nearest_render_pos), vec2(0), vec2(renderWidth - 1, renderHeight - 1)));

    const vec3 color_center = texelFetch(framebufFinal_Sampler, int_render_pos, 0).rgb;
    vec3 color_output = color_center;

    // Color moments in a 3x3 window
    vec3 mom1 = vec3(0.0);
    vec3 mom2 = vec3(0.0);
    {
        const int r = 1;
        for(int yy = -r; yy <= r; yy++)
        {
            for(int xx = -r; xx <= r; xx++)
            {
                ivec2 p = int_render_pos + ivec2(xx, yy);
                p = clamp(p, ivec2(0), ivec2(renderWidth - 1, renderHeight - 1));
                vec3 c = texelFetch(framebufFinal_Sampler, p, 0).rgb;
                mom1 += c;
                mom2 += c * c;
            }
        }
        const float num_pix = 9.0;
        mom1 /= num_pix;
        mom2 /= num_pix;
    }

    // Find the longest motion vector in a 3x3 window
    vec2 motion;
    {
        float len = -1;
        const int r = 1;
        for(int yy = -r; yy <= r; yy++)
        {
            for(int xx = -r; xx <= r; xx++)
            {
                ivec2 p = int_render_pos + ivec2(xx, yy);
                p = clamp(p, ivec2(0), ivec2(renderWidth - 1, renderHeight - 1));
                vec2 m = texelFetch(framebufMotionDlss_Sampler, p, 0).rg;
                float l = dot(m, m);
                if(l > len)
                {
                    len = l;
                    motion = m;
                }
            }
        }
    }

    // Calculate the previous position in the (upscaled) TAA history
    const vec2 pos_prev = ((vec2(opos) + vec2(0.5)) / vec2(outWidth, outHeight) + motion.xy)
        * vec2(outWidth, outHeight);

    // Scale the motion for the weight calculation below
    motion *= vec2(outWidth, outHeight);

    if(all(greaterThanEqual(ivec2(pos_prev), ivec2(1)))
    && all(lessThan(ivec2(pos_prev), ivec2(outWidth, outHeight) - 1)))
    {
        // Motion vector was valid - sample the previous frame's TAA output
        vec3 color_prev = sample_texture_catmull_rom(framebufQ2TaaHistory_Prev_Sampler, pos_prev).rgb;

        if(!any(isnan(color_prev)))
        {
            // Neighbourhood color clamping (NCC)
            vec3 sigma = sqrt(max(vec3(0), mom2 - mom1 * mom1));
            vec3 mi = mom1 - sigma * taa_variance;
            vec3 ma = mom1 + sigma * taa_variance;
            color_prev = clamp(color_prev, mi, ma);

            const float motion_weight = smoothstep(0.0, 1.0, sqrt(dot(motion, motion)));
            const float sample_weight = get_sample_weight(nearest_render_pos - vec2(int_render_pos), float(outWidth) * (1.0 / float(renderWidth)));
            float pixel_weight = max(motion_weight, sample_weight) * taa_motion_weight_mix;
            pixel_weight = clamp(pixel_weight, 0, 1);

            color_output = mix(color_prev, color_center, pixel_weight);
        }
    }

    imageStore(framebufUpscaledPing, opos, vec4(color_output, 1));
    imageStore(framebufQ2TaaHistory, opos, vec4(color_output, 1));
}
